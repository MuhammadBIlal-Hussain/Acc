{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LedgerForge",
  "version": "0.1.0",
  "identifier": "com.ledgerforge.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "LedgerForge ERP",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"]
  }
}
